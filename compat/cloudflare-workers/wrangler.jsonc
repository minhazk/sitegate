{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "sitegate-cloudflare-workers-compat",
  "main": "./worker.ts",
  "compatibility_date": "2026-08-30",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "secrets": {
    "required": ["SITEGATE_PASSWORD", "SITEGATE_SECRET"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}

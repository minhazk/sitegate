{
  "name": "sitegate",
  "version": "0.1.2",
  "description": "A secure, self-hosted password gate for staging and preview websites.",
  "keywords": [
    "password-protection",
    "staging",
    "preview",
    "nextjs",
    "vite",
    "middleware",
    "security"
  ],
  "license": "MIT",
  "author": "Minhaz",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/minhazk/sitegate.git"
  },
  "bugs": {
    "url": "https://github.com/minhazk/sitegate/issues"
  },
  "homepage": "https://github.com/minhazk/sitegate#readme",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md",
    "SECURITY.md",
    "docs"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "import": "./dist/next.js"
    },
    "./vite": {
      "types": "./dist/vite.d.ts",
      "import": "./dist/vite.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=24.0.0 <25"
  },
  "packageManager": "pnpm@11.16.0",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test:run && pnpm build && pnpm pack:check",
    "compat:next": "pnpm build && pnpm --dir compat/next-14 check && pnpm --dir compat/next-15 check && pnpm --dir compat/next-16 check",
    "compat:vite": "pnpm build && pnpm --dir compat/vite-6 check && pnpm --dir compat/vite-7 check && pnpm --dir compat/vite-8 check",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "pack:check": "pnpm pack --dry-run",
    "test": "vitest",
    "test:run": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "jose": "^6.2.8"
  },
  "peerDependencies": {
    "next": ">=14.2.0 <17",
    "vite": ">=6.0.0 <9"
  },
  "peerDependenciesMeta": {
    "next": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.7",
    "@types/node": "^24.13.3",
    "@vitest/coverage-v8": "^4.1.10",
    "next": "16.2.12",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "8.2.1",
    "vitest": "^4.1.10"
  }
}

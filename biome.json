{
  "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!coverage",
      "!**/.nuxt",
      "!**/.output",
      "!**/.svelte-kit",
      "!**/.astro",
      "!compat/sveltekit/build",
      "!test-results",
      "!playwright-report",
      "!node_modules",
      "!compat/cloudflare-workers/worker-configuration.d.ts"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "security": "on",
      "complexity": {
        "useLiteralKeys": "off"
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  }
}
